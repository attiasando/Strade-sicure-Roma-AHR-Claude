# Serve SOLO allo script dell'agente storico (npm run agente:storico), mai al sito.
# Copia questo file in .env e inserisci la tua chiave. Il file .env è ignorato da git.
EXA_API_KEY=

# Segnalazioni degli utenti (Supabase). Valori pubblici per natura (chiave "publishable"), ma restano fuori da git.
# Per il sito su GitHub Pages vanno impostati come "Variables" del repository (Settings > Secrets and variables > Actions).
# Mai la chiave service_role / secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
